<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\dotnet\Gpui.DotNet\Gpui.DotNet.csproj" />
  </ItemGroup>

  <Target Name="CopyGpuiNativeLibrary" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\..\..\target\debug\gpui_dotnet.dll"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildProjectDirectory)\..\..\..\..\target\debug\gpui_dotnet.dll')" />
  </Target>
</Project>
